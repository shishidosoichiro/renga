#!/usr/bin/env bash
# Print the next sequential NNNN number for files in <dir> (and its done/ subdirectory).
# Usage: next-id <dir>
# Example: next-id issues/
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <dir>" >&2
  exit 1
fi

TARGET="$1"

if [[ ! -d "$TARGET" ]]; then
  echo "error: directory not found: $TARGET" >&2
  exit 1
fi


max=$(find "$TARGET" -maxdepth 2 -name '*.md' \
  | grep -oE '/[0-9]{4,5}-' | grep -oE '[0-9]+' | sort -n | tail -1 || true)

printf '%05d\n' "$(( 10#${max:-0} + 1 ))"
