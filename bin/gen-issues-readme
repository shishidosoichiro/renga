#!/usr/bin/env python3
"""Regenerate issues/README.md from frontmatter in issues/*.md.

Operates on issues/ in the current working directory.

Usage:
  bin/gen-issues-readme                  # regenerate issues/README.md
  bin/gen-issues-readme --stdout         # print to stdout instead
  bin/gen-issues-readme --area auth      # filter by area
  bin/gen-issues-readme --label security # filter by label
  bin/gen-issues-readme --status open    # filter by status (comma-separated)
"""

import sys
import argparse
try:
    import yaml
    HAS_YAML = True
except ImportError:
    HAS_YAML = False
from pathlib import Path

ISSUES_DIR = Path.cwd() / "issues"

PRIORITY_LABELS = {
    "high": "高",
    "medium": "中",
    "low": "低",
}


def load_config() -> dict:
    config_path = Path.cwd() / ".fbim.yml"
    if config_path.exists() and HAS_YAML:
        with open(config_path, encoding="utf-8") as f:
            return yaml.safe_load(f) or {}
    return {}

CONFIG = load_config()
AREA_ORDER: list[str] = CONFIG.get("area_order", [])
AREA_LABELS: dict[str, str] = CONFIG.get("area_labels", {})


def parse_frontmatter(content: str) -> dict:
    fm = {}
    lines = content.split("\n")
    if not lines or lines[0].strip() != "---":
        return fm
    in_fm = False
    for line in lines:
        stripped = line.strip()
        if stripped == "---":
            if not in_fm:
                in_fm = True
                continue
            else:
                break
        if in_fm and ":" in line:
            key, _, val = line.partition(":")
            key = key.strip()
            val = val.strip()
            if val.startswith("[") and val.endswith("]"):
                inner = val[1:-1].strip()
                val = [v.strip() for v in inner.split(",") if v.strip()] if inner else []
            fm[key] = val
    return fm


def get_title(content: str) -> str:
    import re
    for line in content.split("\n"):
        if line.startswith("# "):
            title = line[2:].strip()
            title = re.sub(r"^\d+:\s*", "", title)
            return title
    return ""


def collect_issues(filter_area=None, filter_label=None, filter_status=None):
    issues = []
    for path in sorted(ISSUES_DIR.glob("[0-9][0-9][0-9][0-9]-*.md")):
        content = path.read_text(encoding="utf-8")
        fm = parse_frontmatter(content)
        if not fm:
            continue

        status = fm.get("status", "open")
        area = fm.get("area", "misc")
        priority = fm.get("priority", "medium")
        labels = fm.get("labels", [])
        if isinstance(labels, str):
            labels = [labels] if labels else []

        if filter_status and status not in filter_status:
            continue
        if filter_area and area != filter_area:
            continue
        if filter_label and filter_label not in labels:
            continue

        issues.append({
            "id": path.stem[:4],
            "file": path.name,
            "status": status,
            "area": area,
            "priority": priority,
            "labels": labels,
            "title": get_title(content),
        })

    return issues


def generate(filter_area=None, filter_label=None, filter_status=None) -> str:
    if filter_status is None:
        filter_status = ["open", "pending"]

    issues = collect_issues(filter_area, filter_label, filter_status)

    by_area: dict[str, list] = {}
    for issue in issues:
        by_area.setdefault(issue["area"], []).append(issue)

    if AREA_ORDER:
        unknown_areas = sorted(a for a in by_area if a not in AREA_ORDER)
        ordered_areas = [a for a in AREA_ORDER if a in by_area] + unknown_areas
    else:
        ordered_areas = sorted(by_area.keys())

    lines = [
        "# Issues",
        "",
        "Open issues and decisions.",
        "",
        "Status: `open` = needs action / `pending` = blocked or deferred",
        "",
        "Closed issues are moved to `done/`.",
        "",
        "---",
        "",
    ]

    for area in ordered_areas:
        area_issues = by_area.get(area, [])
        if not area_issues:
            continue

        lines.append(f"## {AREA_LABELS.get(area, area)}")
        lines.append("")
        lines.append("| # | status | priority | title |")
        lines.append("|---|---|---|---|")

        for issue in area_issues:
            lines.append(
                f"| [{issue['id']}]({issue['file']}) | {issue['status']} | {issue['priority']} | {issue['title']} |"
            )

        lines.append("")
        lines.append("---")
        lines.append("")

    return "\n".join(lines)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Regenerate issues/README.md")
    parser.add_argument("--area", help="area でフィルタリング")
    parser.add_argument("--label", help="label でフィルタリング")
    parser.add_argument("--status", help="status でフィルタリング（カンマ区切り）", default="open,pending")
    parser.add_argument("--stdout", action="store_true", help="標準出力に出力（ファイルに書かない）")
    args = parser.parse_args()

    filter_status = [s.strip() for s in args.status.split(",")] if args.status else None

    content = generate(
        filter_area=args.area,
        filter_label=args.label,
        filter_status=filter_status,
    )

    if args.stdout:
        print(content)
    else:
        output = ISSUES_DIR / "README.md"
        output.write_text(content + "\n", encoding="utf-8")
        print(f"Generated: {output}", file=sys.stderr)
