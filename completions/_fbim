#compdef fbim

_fbim() {
    local state

    _arguments \
        '1: :->command' \
        '*: :->args'

    case $state in
        command)
            local commands=(
                'create:Create an issue'
                'done:Close an issue'
                'pending:Put an issue on hold'
                'reopen:Reopen a closed issue'
                'list:List issues'
                'show:Show issue details'
                'help:Show help'
            )
            _describe 'command' commands
            ;;
        args)
            case $words[2] in
                create)
                    _arguments \
                        '--slug[kebab-case slug]:slug' \
                        '--priority[priority level]:priority:(high medium low)' \
                        '--area[area name]:area' \
                        '--body[body text]:body'
                    ;;
                done|pending|show)
                    _fbim_open_issues
                    ;;
                reopen)
                    _fbim_done_issues
                    ;;
                list)
                    _arguments \
                        '--json[output as JSON]' \
                        '--status[filter by status]:status:(open pending done)' \
                        '--area[filter by area]:area' \
                        '--label[filter by label]:label'
                    ;;
                help)
                    local commands=(create done pending reopen list show help)
                    _describe 'command' commands
                    ;;
            esac
            ;;
    esac
}

# Walk up from PWD to find issues directory (mirrors bin/fbim logic).
_fbim_find_issues_dir() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.fbim.yml" ]]; then
            local rel
            rel=$(grep -m1 '^issues_dir' "$dir/.fbim.yml" 2>/dev/null \
                | sed 's/^issues_dir[[:space:]]*:[[:space:]]*//' \
                | tr -d '"'"'")
            echo "${dir}/${rel:-issues}"
            return 0
        fi
        if [[ -d "$dir/issues" ]]; then
            echo "$dir/issues"
            return 0
        fi
        dir="${dir:h}"
    done
    return 1
}

_fbim_open_issues() {
    local issues_dir
    issues_dir=$(_fbim_find_issues_dir) || return
    local issues=()
    for f in "$issues_dir"/[0-9][0-9][0-9][0-9]-*.md(N) "$issues_dir"/[0-9][0-9][0-9][0-9][0-9]-*.md(N); do
        local stem="${f:t:r}"
        local num="${stem%%[-]*}"
        local title
        title=$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^# //')
        issues+=("${num}:${title:-$stem}")
    done
    _describe 'issue' issues
}

_fbim_done_issues() {
    local issues_dir
    issues_dir=$(_fbim_find_issues_dir) || return
    local issues=()
    for f in "$issues_dir/done"/[0-9][0-9][0-9][0-9]-*.md(N) "$issues_dir/done"/[0-9][0-9][0-9][0-9][0-9]-*.md(N); do
        local stem="${f:t:r}"
        local num="${stem%%[-]*}"
        local title
        title=$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^# //')
        issues+=("${num}:${title:-$stem}")
    done
    _describe 'issue' issues
}

_fbim "$@"
